# Jei šie kintamieji nenustatyti, programėlė veikia DEMO režimu su aiškiai pažymėtais pavyzdiniais duomenimis.
# Kai sukonfigūruojama Supabase, programėlė automatiškai pereina į LIVE duomenų šaltinį.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push (Alert Center pranešimams). Viešas VAPID raktas — privatus raktas lieka tik backend'e.
VITE_VAPID_PUBLIC_KEY=
